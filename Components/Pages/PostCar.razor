@page "/postcaradd"
@using TodoList.Models 
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer
@inject NavigationManager navManager

<PageTitle>Car Add</PageTitle>

<button class="btn btn-success mb-3" @onclick="GoToAddCar">
    ➕ หน้าหลัก (AddCar)
</button>

<h3 class="text-center mb-4">Car Add</h3>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="form-group">
                        <label for="Type">Type : </label>
                        <InputText id="Type" class="form-control" @bind-Value="cars.Type" />
                    </div>

                    <div class="form-group">
                        <label for="Quantity">Quantity : </label>
                        <input type="text" @bind="cars.Quantity" class="form-control w-90" />
                    </div>

                    <div class="form-group">
                        <label for="Start">Time Start : </label>
                        <InputDate @bind-Value="cars.Start" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label for="End">Time End :</label>
                        <InputDate @bind-Value="cars.End" class="form-control" />
                    </div>

                    <div class="form-group text-center mt-4">
                        <button class="btn btn-primary w-100"
                                style="background-color: #4fa69b; border-color: #4fa69b; color: white;"
                                @onclick="HandleValidSubmit">
                            Car Add
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(responseMessage))
                    {
                        <div class="mt-3 alert alert-info">
                            @responseMessage
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CarAddPost cars = new CarAddPost();
    private string? responseMessage;
    private HttpClient Http => HttpClientFactory.CreateClient("BackEndCar");

    private async Task HandleValidSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Events", cars);

            if (response.IsSuccessStatusCode)
            {
                responseMessage = "เพิ่มรายการรถเรียบร้อยแล้ว";
                cars = new CarAddPost();  // reset form
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                responseMessage = $"เพิ่มรายการรถไม่สำเร็จ: {response.StatusCode} - {error}";
            }
        }
        catch (Exception ex)
        {
            responseMessage = $"ข้อผิดพลาด: {ex.Message}";
        }

    }
    private void GoToAddCar()
    {
        navManager.NavigateTo("/getcaradd");
    }
}

@page "/putcaradd"
@page "/putcaradd/{id:int}"
@using TodoList.Models 
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager navManager
@inject HttpClient _http
@rendermode InteractiveServer

<PageTitle>Put Car</PageTitle>

<h3 class="text-center mb-4">Put Car</h3>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">

                    <EditForm Model="cars" OnValidSubmit="HandleValidSubmit">
                        <div class="form-group">
                            <label for="Id">ID:</label>
                            <InputNumber id="Id" class="form-control" @bind-Value="cars.Id" disabled />
                        </div>

                        <div class="form-group">
                            <label for="Type">Type:</label>
                            <InputText id="Type" class="form-control" @bind-Value="cars.Type" />
                        </div>

                        <div class="form-group">
                            <label for="Quantity">Quantity:</label>
                            <InputNumber id="Quantity" class="form-control" @bind-Value="cars.Quantity" />
                        </div>

                        <div class="form-group">
                            <label for="Start">Start Date:</label>
                            <InputDate id="Start" class="form-control" @bind-Value="cars.Start" />
                        </div>

                        <div class="form-group">
                            <label for="End">End Date (optional):</label>
                            <InputDate id="End" class="form-control" @bind-Value="cars.End" />
                        </div>

                        <div class="form-group text-center mt-4">
                            <button class="btn btn-primary w-100" type="submit">Update Car</button>
                        </div>
                    </EditForm>

                    @if (!string.IsNullOrEmpty(responseMessage))
                    {
                        <div class="mt-3 alert alert-info">
                            @responseMessage
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? id { get; set; }  // รับ id จาก URL

    private CarDto cars = new();
    private string? responseMessage;
    private HttpClient Http => HttpClientFactory.CreateClient("BackEndCar");

    protected override async Task OnInitializedAsync()
    {
        if (id.HasValue)
        {
            try
            {
                var result = await Http.GetFromJsonAsync<CarDto>($"api/Events/{id.Value}");
                if (result != null)
                {
                    cars = result;
                }
                else
                {
                    responseMessage = $"ไม่พบข้อมูลของรถรหัส {id}";
                }
            }
            catch (Exception ex)
            {
                responseMessage = $"โหลดข้อมูลไม่สำเร็จ: {ex.Message}";
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Events/{cars.Id}", cars);
            if (response.IsSuccessStatusCode)
            {
                responseMessage = "แก้ไขข้อมูลรถเรียบร้อยแล้ว";
                navManager.NavigateTo("/getcaradd");
            }
            else
            {
                responseMessage = $"แก้ไขไม่สำเร็จ: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            responseMessage = $"เกิดข้อผิดพลาด: {ex.Message}";
        }
    }
}
